{
    "name": "circular-slider-workspace",
    "private": true,
    "author": "Mark Watson <mark@watsonised.me> (https://get.watsonised.me)",
    "license": "MIT",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev:demo": "npm run dev -w demo_circular-slider-for-react",
        "build:lib": "npm run build -w @watsonised/circular-slider-for-react",
        "bump-publish:lib": "npm version patch -w @watsonised/circular-slider-for-react && npm run publish:lib",
        "publish:lib": "BROWSER=none npm publish -w @watsonised/circular-slider-for-react --access public",
        "build:demo": "npm run build -w demo_circular-slider-for-react",
        "storybook": "npm run storybook -w @watsonised/circular-slider-for-react",
        "build:storybook": "npm run build:storybook -w @watsonised/circular-slider-for-react",
        "reset": "rm -rf node_modules package-lock.json packages/*/node_modules packages/*/package-lock.json && npm i",
        "update": "npx npm-check-updates --workspaces -x 'vitest,@vitest/*' -u"
    }
}
